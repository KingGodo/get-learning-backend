# Copy to .env on the droplet. Do not commit real secrets.

DATABASE_URL=postgresql://getleaning:CHANGE_ME@127.0.0.1:5432/getlearning_db

PORT=4000
HOST=127.0.0.1
NODE_ENV=production

# Public origin of this droplet (Nginx). Used for uploaded file URLs.
PUBLIC_APP_URL=http://24.144.113.162

# Same origin as the Next.js app on this droplet.
FRONTEND_URL=http://24.144.113.162
# Optional extra origins, comma-separated (custom domain, preview URL).
CORS_ORIGINS=

# At least 16 characters. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

SEED_ADMIN_EMAIL=admin@getleaning.local
SEED_ADMIN_PASSWORD=CHANGE_ME

# Leave empty to store files on the droplet under /uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lms-files
