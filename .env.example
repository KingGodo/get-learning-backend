# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/getlearning_db

# Server
PORT=4000
# Bind to all interfaces so other devices on your network can reach the API (0.0.0.0).
HOST=0.0.0.0
NODE_ENV=development
# Used to build absolute local file URLs. Leave empty for relative /uploads/... paths.
# Production: public HTTPS origin of this API, e.g. https://api.example.com
PUBLIC_APP_URL=http://localhost:4000
# Frontend origin used in password-reset emails/links and CORS.
# Production: Vercel URL, e.g. https://getleaning.vercel.app
FRONTEND_URL=http://localhost:3000
# Optional extra CORS origins (comma-separated), no trailing slashes.
CORS_ORIGINS=

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Seed — system admin (used by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@getleaning.local
SEED_ADMIN_PASSWORD=Admin@12345

# Supabase Storage (optional — if empty, files are stored under /uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Must match an existing Supabase Storage bucket (create one if missing).
# Make it Public, or the API will issue signed URLs automatically.
SUPABASE_STORAGE_BUCKET=lms-files
